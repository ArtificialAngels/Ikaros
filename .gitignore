hermes-studio/node_modules/
hermes-studio/dist/
hermes-studio/packages/server/dist/
hermes-studio/packages/desktop/dist/
hermes-studio/packages/desktop/release/
hermes-studio/packages/desktop/resources/
hermes-studio/packages/*/node_modules/
hermes-studio/.hermes-web-ui/
hermes-studio/logs/

