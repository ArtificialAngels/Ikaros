bin/oldcode/

# === UNCONDITIONAL 7-4 lockout (AGENTSMD wants NO oldcode sync) ===
oldcode/
oldcode/**
/oldcode/
**/oldcode/

# === Ikaros v3 记忆数据库 — NEVER push (哥哥 7-4 明令) ===
Ikaros-memory/data/v3.db
Ikaros-memory/data/v3.db-*
Ikaros-memory/data/*.db
Ikaros-memory/data/space/
Ikaros-memory/data/_workspace/

# === Ikaros-memory 运行时配置 — 本地保留,不推送 ===
Ikaros-memory/data/
Ikaros-memory/services/launchd/

# === 2026-07-05: ephemeral / generated artifacts (binaries + clones) ===

# Quest 7-4 Rust build artifacts (cargo target/).  Source lives in
# Ikaros-environment/scripts/detect-root/ (committed) and rebuilds
# via `cargo build --release`.  The .exe is regenerated each time
# and must NOT enter the repo (~110MB).
Ikaros-environment/detect-root/target/
Ikaros-environment/detect-root/Cargo.lock
Ikaros-environment/scripts/detect-root.exe
Ikaros-environment/ikaros-cli/target/
Ikaros-environment/ikaros-cli/Cargo.lock

# bin/ikaros-monitor.exe is the Rust monitor binary rebuilt from
# bin/ikaros-desktop-pet/agent/.  Skip the binary; commit the source
# .py / .ps1 / .vbs files in the same dir.
bin/ikaros-monitor.exe

# tools/ikaros-monitor/ is a standalone Rust workspace (cargo).  Ignore
# its build output (target/) — regenerated by `cargo build --release`.
# Source under tools/ikaros-monitor/src/ is committed.
tools/ikaros-monitor/target/

# exProject/ holds sibling open-source clones (Live2DPet, MewCo-AI,
# etc.) that Ikaros reads for inspiration but does not re-distribute.
# 1.2 GB+ of source — never push.
exProject/

# launch-hidden.vbs is a per-host Windows startup shim that points at
# the user's logged-in shell.  Path is hard-coded to the host's
# username (PZS0X) and is not portable; do not push.
bin/launch-hidden.vbs

# 2026-07-05 (哥哥 instruction): hermes agent verify scripts and
# ad-hoc verification artifacts must live under the project root
# (e.g. Ikaros/tmp/hermes-verify/), not under the OS-default
# C:/Users/<user>/AppData/Local/Temp/ which yields stray roots
# like E:/Users/.  The tmp/ tree is per-host and never pushes.
tmp/
tmp/**

# --- Agent workspace data (WorkBuddy / CodeBuddy local state) ---
# These hold agent memory, session logs, and task state. They are
# host-specific and must NEVER enter the repo.
.workbuddy/
.codebuddy/
nul

