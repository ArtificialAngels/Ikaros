# ============================================================
# llama-server router-mode preset (b9538+)
#
# Section name = GGUF filename. Each section overrides the
# global --host/--port/--jinja with per-model defaults.
#
# Per-model settings supported (any subset):
# model (path within --models-dir; default = section name)
# n-gpu-layers (default0 = full CPU;99 = full GPU offload)
# ctx-size (context window; cap at the model's n_ctx_train)
# temp (sampling temperature)
# top-k, top-p, min-p
# prompt (system prompt prefix)
# ============================================================
# Default: 256K ctx (= qwen35moe.context_length=262144).
# 35B-A3B MoE 模型的 GGUF metadata 写明 256K，因此 256K
# 是"本机最大可用 ctx"，跟模型原生能力对齐。VRAM 8GB 下不会
# 一次性把 KV cache 全部放 GPU，但 llama-server 会把 KV
# cache 自动 spill 到 RAM（--ctx-size 只是上限，不是预分配）。
#
# 用户在 webui 里可针对每个 session 在 "Context Length" 字段
# 临时调小（API: POST /api/hermes/sessions/context-length），
# 让小显存机器也能用。

# Qwen3.6-35B-A3B-UD-IQ2_M, 11.5 GB file. 256K ctx.
# 35B-A3B MoE, 2.0-bit IQ quant, lightest variant.
[Qwen3.6-35B-A3B-UD-IQ2_M.gguf]
n-gpu-layers = 16
ctx-size = 262144
temp = 0.7

# Qwen3.6-35B-A3B-UD-Q3_K_M, 16.6 GB file. 256K ctx.
# Medium quality (3-bit) — sweet spot for 16GB VRAM.
[Qwen3.6-35B-A3B-UD-Q3_K_M.gguf]
n-gpu-layers = 16
ctx-size = 262144
temp = 0.7

# Qwen3.6-35B-A3B-UD-Q6_K, 29.3 GB file. 256K ctx.
# Higher quality (6.0-bit) but biggest file — needs 32GB RAM.
[Qwen3.6-35B-A3B-UD-Q6_K.gguf]
n-gpu-layers = 16
ctx-size = 262144
temp = 0.7
