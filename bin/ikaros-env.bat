@echo off
rem ikaros-env.bat — Ikaros 便携环境 (自锚定)
rem 由各入口 bat call 本文件; 生成: 2026-08-11
set "IKAROS_ROOT=%~dp0.."
set "IKAROS_BIN=%IKAROS_ROOT%\bin"
set "IKAROS_CONFIG=%IKAROS_ROOT%\config"
set "IKAROS_DATA=%IKAROS_ROOT%\data"
set "IKAROS_HERMES_AGENT=%IKAROS_ROOT%\runtime\hermes-agent"
set "IKAROS_HERMES_HOME=%IKAROS_ROOT%\data\hermes-agent"
set "IKAROS_LABEL_EMOTION_PROVIDER=local"
set "IKAROS_LLAMA_DIR=%IKAROS_ROOT%\runtime\llama\b10000-cuda"
set "IKAROS_LLAMA_SERVER=%IKAROS_ROOT%\runtime\llama\b10000-cuda\llama-server.exe"
set "IKAROS_LLAMA_VERSION=b10000-cuda"
set "IKAROS_LOGS=%IKAROS_ROOT%\data\logs"
set "IKAROS_MEMORY_DATA=%IKAROS_ROOT%\core\memory_v5\data"
set "IKAROS_MEMORY_MODELS=%IKAROS_ROOT%\core\memory_v5\models"
set "IKAROS_MEMORY_SCRIPT=%IKAROS_ROOT%\core\memory_v5\store.py"
set "IKAROS_MEMORY=%IKAROS_ROOT%\core\memory_v5"
set "IKAROS_MODEL_EMBEDDING=%IKAROS_ROOT%\core\memory_v5\models\nomic-embed-text-v2-moe.f32.gguf"
set "IKAROS_MODEL_LLM=%IKAROS_ROOT%\core\memory_v5\models\Phi-4-mini-instruct-Q4_K_M.gguf"
