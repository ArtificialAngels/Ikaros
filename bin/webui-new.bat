@echo off
REM ============================================================
REM Hermes WebUI (EKKOLearnAI v0.6.11) Launcher
REM ----------------------------------------------------------
REM Boots the new Vue3 + Koa webui, talking to the local
REM   - llama-server  : http://127.0.0.1:8080/v1  (OpenAI-compat)
REM   - hermes-agent  : via portable-python\python.exe + hermes_bridge.py
REM
REM App lives at E:\Hermes Agent\data\webui-new\app (junction to E:\hermes-web-ui-main)
REM Data lives at E:\Hermes Agent\data\webui-new\data\ + data\hermes-agent\
REM
REM Usage:
REM   webui-new            start (daemon)
REM   webui-new start      start (daemon)
REM   webui-new stop       stop daemon
REM   webui-new restart    restart
REM   webui-new status     show pid
REM   webui-new fg         start in foreground (debug)
REM ============================================================
setlocal enabledelayedexpansion
chcp 65001 >nul

set "HERMES_ROOT=%~dp0.."
set "APP_DIR=%HERMES_ROOT%\data\webui-new\app"
set "PY=%HERMES_ROOT%\portable-python\python.exe"
set "WEBUI_HOME=%HERMES_ROOT%\data\webui-new\data"
set "HERMES_HOME=%HERMES_ROOT%\data\hermes-agent"
set "WEBUI_PORT=8648"
set "LLAMA_URL=http://127.0.0.1:8080/v1"

REM ---- pick the first arg as command (default: start) ----
set "CMD=%~1"
if "%CMD%"=="" set "CMD=start"
shift

REM ---- sanity checks ----
if not exist "%APP_DIR%\bin\hermes-web-ui.mjs" (
    echo [ERROR] webui-new\app junction missing or webui build missing.
    echo         Run: mklink /J "%APP_DIR%" "E:\hermes-web-ui-main"
    echo         And:  cd E:\hermes-web-ui-main ^&^& npm install ^&^& npm run build
    exit /b 1
)
if not exist "%PY%" (
    echo [ERROR] portable Python not found at %PY%
    exit /b 1
)

REM ---- always inject portable Python into PATH for hermes_bridge.py ----
set "PATH=%HERMES_ROOT%\portable-python;%HERMES_ROOT%\portable-python\Scripts;%PATH%"

REM ---- core env (visible to webui server + hermes_bridge.py) ----
set "HERMES_AGENT_BRIDGE_PYTHON=%PY%"
if exist "%HERMES_ROOT%\portable-python\Scripts\uv.exe" set "HERMES_AGENT_BRIDGE_UV=%HERMES_ROOT%\portable-python\Scripts\uv.exe"
set "HERMES_AGENT_ROOT=%HERMES_ROOT%\hermes-agent-source"
set "HERMES_WEB_UI_HOME=%WEBUI_HOME%"
set "HERMES_HOME=%HERMES_HOME%"
set "HERMES_WEB_UI_DISABLE_GATEWAY_AUTOSTART=1"
set "HERMES_WEB_UI_DISABLE_SKILL_INJECTION="
set "PORT=%WEBUI_PORT%"
set "PYTHONIOENCODING=utf-8"
set "PYTHONUTF8=1"

REM ---- bootstrap hermes-agent config (first run only) ----
if not exist "%HERMES_HOME%\config.yaml" (
    echo [setup] writing minimal hermes-agent config to %HERMES_HOME%\config.yaml
    if not exist "%HERMES_HOME%" mkdir "%HERMES_HOME%" 2>nul
    (
        echo # hermes-agent config — generated by webui-new.bat
        echo providers:
        echo   llama-local:
        echo     type: openai
        echo     base_url: %LLAMA_URL%
        echo     api_key: not-needed
        echo     models:
        echo       - qwen2.5-3b-instruct
        echo default:
        echo   provider: llama-local
        echo   model: qwen2.5-3b-instruct
    ) > "%HERMES_HOME%\config.yaml"
)

REM ---- dispatch ----
cd /d "%APP_DIR%"
if /i "%CMD%"=="fg" goto :fg
if /i "%CMD%"=="stop" goto :stop
if /i "%CMD%"=="restart" goto :restart
if /i "%CMD%"=="status" goto :status
if /i "%CMD%"=="start" goto :start
echo [ERROR] unknown command: %CMD%  (use start^|stop^|restart^|status^|fg)
exit /b 1

:start
echo ============================================================
echo   Hermes WebUI ^(EKKOLearnAI v0.6.11^)
echo   Port:        http://localhost:%WEBUI_PORT%/
echo   Data:        %WEBUI_HOME%
echo   Hermes home: %HERMES_HOME%
echo   Bridge py:   %PY%
echo ============================================================
node bin\hermes-web-ui.mjs start %*
exit /b %ERRORLEVEL%

:stop
node bin\hermes-web-ui.mjs stop
exit /b %ERRORLEVEL%

:restart
node bin\hermes-web-ui.mjs stop
timeout /t 2 /nobreak >nul
node bin\hermes-web-ui.mjs start
exit /b %ERRORLEVEL%

:status
node bin\hermes-web-ui.mjs status
exit /b %ERRORLEVEL%

:fg
echo [fg] starting in foreground (Ctrl+C to stop)
node bin\hermes-web-ui.mjs %*
exit /b %ERRORLEVEL%
