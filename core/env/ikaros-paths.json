{
  "_comment": "Ikaros 路径配置 - 全部为相对 IKAROS_ROOT 的相对路径（可整体迁移盘符/目录）。ikaros_root 置空表示由加载方动态探测。",
  "_version": "2.0",
  "ikaros_root": "",
  "core": {
    "python": "runtime/portable-python/python.exe",
    "portable_python": "runtime/portable-python/python.exe",
    "runtime": "runtime",
    "node": "runtime/node/node.exe",
    "npm": "runtime/node/npm.cmd",
    "node_modules": "runtime/node/node_modules",
    "aria2": "runtime/aria2",
    "gopeed": "runtime/gopeed",
    "rpc_server": "runtime/rpc-server",
    "data": "data",
    "data_models": "data/models",
    "bin": "bin",
    "config": "config",
    "logs": "data/logs"
  },
  "hermes": {
    "agent": "runtime/hermes-agent",
    "home": "data/hermes-agent",
    "bridge": "bridge",
    "core": "runtime/hermes-agent"
  },
  "memory": {
    "root": "core/memory_v5",
    "data": "core/memory_v5/data",
    "models": "core/memory_v5/models",
    "db": "core/memory_v5/data/v5/v5.db",
    "chromadb": "core/memory_v5/data/v5/chroma"
  },
  "llama": {
    "version": "b10000-cuda",
    "dir": "runtime/llama/b10000-cuda",
    "server": "runtime/llama/b10000-cuda/llama-server.exe",
    "cli": "runtime/llama/b10000-cuda/llama-cli.exe"
  },
  "models": {
    "embedding": "core/memory_v5/models/nomic-embed-text-v2-moe.f32.gguf",
    "llm": "core/memory_v5/models/Qwen_Qwen3-1.7B-Q4_K_M.gguf"
  },
  "neko": {
    "root": "apps/neko",
    "python": "apps/neko/.venv/Scripts/python.exe",
    "server": "app.main_server",
    "desktop": "apps/neko/N.E.K.O.exe",
    "static": "apps/neko/static",
    "templates": "apps/neko/templates",
    "venv": "apps/neko/.venv",
    "start_script": "bin/neko-start.bat",
    "stop_script": "bin/neko-stop.bat"
  },
  "mcp": {
    "root": "runtime/MCPServe",
    "codebase_memory_exe": "runtime/MCPServe/codebase-memory/package/bin/codebase-memory-mcp.exe",
    "graphify": "runtime/MCPServe/graphify",
    "graphify_serve": "runtime/MCPServe/graphify/graphify/serve.py"
  },
  "ports": {
    "embedding": 8587,
    "llama": 8080,
    "bridge": 7860,
    "neko_main": 48911,
    "neko_memory": 48912,
    "neko_bridge": 9460
  }
}
