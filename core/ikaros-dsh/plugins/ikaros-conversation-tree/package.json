{
  "name": "@ikaros/dsh-conversation-tree",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "description": "Ikaros 对话树 dsh 插件：server.py 看门狗拉起 + sidebar 入口 + shell.overlay 全屏 iframe + dsh 设置面板 CT 6 分区（主题/权限/布局/粒子/语言）",
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArtificialAngels/Ikaros.git",
    "directory": "core/ikaros-dsh/plugins/ikaros-conversation-tree"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": ["slots"]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin",
    "src",
    "scripts",
    "tsconfig.build.json"
  ],
  "devDependencies": {
    "esbuild": "^0.21.0",
    "typescript": "^5.5.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0"
  },
  "license": "MIT",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
