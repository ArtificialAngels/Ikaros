{
  "name": "@ikaros/dsh-ikaros-memory",
  "version": "0.2.0",
  "type": "module",
  "main": "dist/index.js",
  "description": "Ikaros memory_v5 dsh 插件：自动记忆工程层（pre-step 召回/turn-stopping 沉淀/compaction 捕获/6h 维护）+ embedding 模型控制面板（dsh 设置页）",
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArtificialAngels/Ikaros.git",
    "directory": "core/ikaros-dsh/plugins/ikaros-memory"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": ["slots"]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "esbuild": "^0.21.0",
    "typescript": "^5.5.0"
  },
  "files": [
    "dist",
    "bin",
    "src",
    "scripts",
    "tsconfig.build.json"
  ],
  "license": "MIT",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
