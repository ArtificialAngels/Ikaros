{
  "name": "agent_bridge_stub",
  "version": "1.0.0",
  "description": "Minimal TCP stub for the npm hermes-web-ui Agent Bridge broker (tcp://127.0.0.1:18765). The real broker (hermes_bridge.py) is supposed to ship with the npm package, but the npm install in this project places the script under node_modules/.hermes-web-ui-<hash>/.../agent-bridge/python/ -- a path webui's G4I() does not search. Without a broker, any session with source=api_server triggers 'Unable to confirm Agent Bridge status while resuming: connect ECONNEFUSED' on resume. This stub answers status_if_loaded with running:false so webui's reattachBridgeRun takes the early-return path. The local FastAPI bridge on :7860 (via modules/webui_proxy._proxy_to_bridge) covers all session/icarus/memory/RAG needs the real broker would have provided; this stub is strictly a wire-protocol shim to satisfy webui's broker lookup. See AGENTS.md §0.8b.",
  "type": "service",
  "runtime": {
    "kind": "python",
    "python": "portable-python/python.exe",
    "script": "agent_bridge_stub.py",
    "args": [],
    "working_directory": "."
  },
  "network": {
    "host": "127.0.0.1",
    "port": 18765,
    "protocol": "tcp",
    "health_endpoint": null,
    "health_timeout_ms": 2000
  },
  "lifecycle": {
    "start": "start.ps1",
    "stop": "stop.ps1",
    "health": "health.ps1",
    "startup_timeout_s": 10,
    "shutdown_timeout_s": 5
  },
  "depends_on": [],
  "env": {}
}
