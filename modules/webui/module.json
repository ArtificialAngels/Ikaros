{
  "name": "webui",
  "version": "1.0.0",
  "description": "hermes-web-ui — Node.js BFF + Vue 3 SPA. Serves UI on :8648, proxies chat to llama-server/bridge.",
  "type": "service",
  "runtime": {
    "kind": "node",
    "node": "deps/node/node.exe",
    "entry": "hermes-web-ui.mjs",
    "args": ["start", "8648"],
    "working_directory": "."
  },
  "network": {
    "host": "127.0.0.1",
    "port": 8648,
    "protocol": "http",
    "health_endpoint": "/health",
    "health_timeout_ms": 5000
  },
  "lifecycle": {
    "start": "start.ps1",
    "stop": "stop.ps1",
    "health": "health.ps1",
    "startup_timeout_s": 60,
    "shutdown_timeout_s": 10
  },
  "depends_on": [
    { "module": "llm_engine", "required": false, "reason": "chat completions source" },
    { "module": "bridge", "required": false, "reason": "model management proxy" }
  ],
  "env": {
    "HERMES_WEB_UI_DISABLE_GATEWAY_AUTOSTART": "1",
    "CORS_ORIGINS": "*"
  }
}
