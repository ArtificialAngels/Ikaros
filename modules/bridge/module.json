{
  "name": "bridge",
  "version": "2.0.0",
  "description": "Rust bridge (Phase 1) — axum+tokio reverse proxy to llama-server. Fallback to Python uvicorn if Rust binary missing.",
  "type": "service",
  "runtime": {
    "kind": "rust",
    "binary": "bridge-rs/target/release/hermes-bridge-rs.exe",
    "working_directory": "."
  },
  "network": {
    "host": "127.0.0.1",
    "port": 7860,
    "protocol": "http",
    "health_endpoint": "/health",
    "health_timeout_ms": 5000
  },
  "lifecycle": {
    "start": "start.ps1",
    "stop": "stop.ps1",
    "health": "health.ps1",
    "startup_timeout_s": 120,
    "shutdown_timeout_s": 10
  },
  "depends_on": [
    { "module": "llm_engine", "required": false, "reason": "proxies /v1/chat/completions to llama-server" }
  ],
  "env": {
    "HERMES_LLAMA_URL": "http://127.0.0.1:8080",
    "HERMES_LLAMA_FALLBACKS": "http://127.0.0.1:8081,http://127.0.0.1:9999"
  }
}
